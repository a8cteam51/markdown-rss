{
  "name": "a8cteam51/markdown-rss",
  "type": "wordpress-plugin",
  "version": "1.0.0",
  "description": "Adds the element <source:markdown> to the RSS feed.",
  "homepage": "https://github.com/a8cteam51/markdown-rss",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Automattic Special Projects Team",
      "homepage": "https://specialprojects.automattic.com/"
    },
    {
      "name": "Contributors",
      "homepage": "https://github.com/a8cteam51/markdown-rss/graphs/contributors"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/a8cteam51/team51-configs"
    }
  ],
  "require": {
    "php": ">=7.2",
    "league/html-to-markdown": "^5.1"
  },
  "require-dev": {
    "a8cteam51/team51-configs": "dev-trunk",
    "johnpbloch/wordpress-core": "6.9.*",
    "wp-cli/i18n-command": "^2",
    "roave/security-advisories": "dev-latest"
  },
  "scripts": {
    "generate-autoloader": "@composer dump-autoload -o",
    "format:php": "phpcbf --standard=./.phpcs.xml --basepath=. . -v",
    "lint:php": "phpcs --standard=./.phpcs.xml --basepath=. . -v",
    "internationalize": [
      "@makepot",
      "@updatepo"
    ],
    "makepot": "wp i18n make-pot .",
    "updatepo": "wp i18n update-po ./languages/markdown-rss.pot",
    "makemo": "wp i18n make-mo ./languages",
    "packages-install": "@composer install --ignore-platform-reqs --no-interaction",
    "packages-update": [
      "@composer clear-cache",
      "@composer update --prefer-stable --no-interaction"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/*": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
